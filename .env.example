# RetentionIQ Environment Configuration Template
# Copy this file to .env and customize values for your deployment environment.

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
PORT=5000

# Security Keys
# CRITICAL: Generate a cryptographically secure 32-byte secret in production (e.g., `openssl rand -hex 32`)
SECRET_KEY=dev-insecure-secret-key-change-in-production-20261022

# Session Security
# Set to 'true' in production when running behind an SSL/TLS terminating reverse proxy
SESSION_COOKIE_SECURE=false

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///data/retentioniq.db

# Production MySQL Example:
# DATABASE_URL=mysql+pymysql://retentioniq_user:StrongPassword123!@localhost:3306/retentioniq?charset=utf8mb4

# Synthetic Data Generation Seed
RANDOM_SEED=20261022
